---
const { agent } = Astro.props;
---

<div
    class="agent-card group h-full w-full overflow-hidden
         rounded-xl bg-white
         ring-1 ring-slate-200
         shadow-sm transition-all duration-300
         hover:shadow-xl hover:ring-slate-300
         cursor-pointer"
>
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div>
                <p class="text-sm text-slate-500">Agent</p>
                <h3
                    class="text-lg font-semibold tracking-tight text-slate-900
                    group-hover:text-blue-700 transition-colors"
                >
                    {agent.prenom}
                    {agent.nom}
                </h3>
            </div>

            <span
                class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700"
            >
                Profil
            </span>
        </div>

        <div class="mt-5">
            <a
                href={`/agents/${agent.id}`}
                class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700"
            >
                Voir plus
            </a>
        </div>
    </div>
</div>
