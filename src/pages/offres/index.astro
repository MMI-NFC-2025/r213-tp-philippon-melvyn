---
import Layout from "../../layouts/Layout.astro";
import OfferCard from "../../components/OffreCard.astro";
import { getOffres } from "../../js/backend.mjs";

let offres = await getOffres();

let message = "";

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();

    const minPrixRaw = data.get("minPrix")?.toString() ?? "";
    const maxPrixRaw = data.get("maxPrix")?.toString() ?? "";

    const minPrix = Number(minPrixRaw);
    const maxPrix = Number(maxPrixRaw);

    const isMinValid = Number.isFinite(minPrix) && minPrix >= 0;
    const isMaxValid = Number.isFinite(maxPrix) && maxPrix >= 0;

    if (!isMinValid || !isMaxValid) {
        message = "Veuillez entrer des nombres valides (>= 0).";
    } else if (maxPrix <= minPrix) {
        message =
            "Le prix maximum doit être strictement supérieur au prix minimum.";
    } else if (maxPrix > 10_000_000) {
        message = "Le prix maximum est trop élevé.";
    } else {
        const allOffres = await getOffres();
        offres = allOffres.filter((o) => {
            const prix = Number(o.prix);
            return Number.isFinite(prix) && prix >= minPrix && prix <= maxPrix;
        });

        message =
            offres.length === 0
                ? `Pas d'offres entre ${minPrix}€ et ${maxPrix}€`
                : `Liste des offres entre ${minPrix}€ et ${maxPrix}€`;
    }
}
---

<Layout titre="Offres">
    <div class="min-h-screen bg-slate-50">
        <header class="relative overflow-hidden">
            <div
                class="absolute inset-0 bg-linear-to-br from-blue-600 via-indigo-600 to-slate-900 opacity-90"
            ></div>
            <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.25),transparent_45%)]"
            ></div>

            <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
                <div class="max-w-2xl">
                    <p
                        class="inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-sm font-medium text-white ring-1 ring-white/25"
                    >
                        Agence immobilière • Sélection du moment
                    </p>

                    <h1
                        class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-white"
                    >
                        Nos offres
                    </h1>

                    <p class="mt-4 text-white/85 text-base sm:text-lg">
                        Parcourez nos biens disponibles et affichez uniquement
                        vos favoris en un clic.
                    </p>

                    <div class="mt-6 flex flex-col sm:flex-row gap-3">
                        <a
                            href="/offres/surfaces/80"
                            class="inline-flex items-center justify-center rounded-xl px-5 py-3
                            bg-emerald-500 text-white font-semibold shadow-sm
                            transition hover:bg-emerald-600 active:scale-[0.99]
                            focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
                        >
                            Surfaces
                        </a>
                    </div>
                </div>

                <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div
                        class="rounded-xl bg-white/10 p-4 ring-1 ring-white/15 backdrop-blur"
                    >
                        <p class="text-sm text-white/75">Offres disponibles</p>
                        <p class="mt-1 text-2xl font-bold text-white">
                            {offres.length}
                        </p>
                    </div>

                    <div
                        class="rounded-xl bg-white/10 p-4 ring-1 ring-white/15 backdrop-blur"
                    >
                        <p class="text-sm text-white/75">Affichage</p>
                        <p class="mt-1 text-2xl font-bold text-white">
                            Catalogue
                        </p>
                    </div>

                    <div
                        class="rounded-xl bg-white/10 p-4 ring-1 ring-white/15 backdrop-blur"
                    >
                        <p class="text-sm text-white/75">Favoris</p>
                        <p class="mt-1 text-2xl font-bold text-white">Filtre</p>
                    </div>
                </div>
            </div>
        </header>

        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-8">
            <form
                action="/offres"
                method="POST"
                class="rounded-xl bg-white border border-slate-200 shadow-sm p-4 flex flex-col md:flex-row gap-3 items-start md:items-end"
            >
                <div class="flex-1">
                    <label
                        class="block text-sm font-medium text-slate-700 mb-1"
                        for="minPrix"
                    >
                        Prix minimum
                    </label>
                    <input
                        id="minPrix"
                        type="number"
                        name="minPrix"
                        placeholder="0"
                        min="0"
                        step="1"
                        required
                        class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <div class="flex-1">
                    <label
                        class="block text-sm font-medium text-slate-700 mb-1"
                        for="maxPrix"
                    >
                        Prix maximum
                    </label>
                    <input
                        id="maxPrix"
                        type="number"
                        name="maxPrix"
                        placeholder="1000000"
                        min="0"
                        step="1"
                        required
                        class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>

                <input
                    type="submit"
                    value="Filtrer par prix"
                    class="inline-flex items-center justify-center rounded-xl px-4 py-2.5
                    bg-blue-600 text-white font-semibold shadow-sm
                    transition hover:bg-blue-700 active:scale-[0.99]
                    focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
                />
            </form>

            {message && <p class="mt-3 text-sm text-slate-700">{message}</p>}
        </div>

        <main id="liste" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
            <div
                class="mb-8 rounded-xl bg-white border border-slate-200 shadow-sm px-4 py-4"
            >
                <div
                    class="flex flex-col md:flex-row md:items-center md:justify-between gap-3"
                >
                    <div>
                        <h2 class="text-lg font-semibold text-slate-900">
                            Catalogue
                        </h2>
                        <p class="text-sm text-slate-600">
                            Cliquez sur le bouton pour afficher uniquement les
                            favoris.
                        </p>
                    </div>

                    <button
                        id="favori-button-duplicate"
                        class="inline-flex items-center justify-center rounded-xl px-4 py-2.5
                        bg-blue-600 text-white font-semibold shadow-sm
                        transition hover:bg-blue-700 active:scale-[0.99]
                        focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
                        type="button"
                    >
                        Afficher les favoris
                    </button>
                </div>
            </div>

            <div class="grid gap-10 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
                {
                    offres.map((offre) => (
                        <div
                            class="offre"
                            data-favori={offre.favori?.toString() ?? "false"}
                        >
                            <OfferCard offre={offre} />
                        </div>
                    ))
                }
            </div>
        </main>
    </div>

    <script>
        const button2 = document.getElementById("favori-button-duplicate");
        let showOnlyFavorites = false;

        const applyFilter = () => {
            const offres = document.querySelectorAll(".offre");

            offres.forEach((offre) => {
                const isFavori = offre.dataset.favori === "true";
                offre.style.display = showOnlyFavorites
                    ? isFavori
                        ? "block"
                        : "none"
                    : "block";
            });

            if (button2) {
                button2.textContent = showOnlyFavorites
                    ? "Afficher tout"
                    : "Afficher les favoris";
            }
        };

        button2?.addEventListener("click", () => {
            showOnlyFavorites = !showOnlyFavorites;
            applyFilter();
        });
    </script>
</Layout>